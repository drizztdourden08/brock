# Every folder that needs ignoring is a dot-folder, and the .*/ line below
# ignores them all, at any depth. A dot-folder the repo tracks gets a ! line
# here. Never add a line for a single dot-folder: .*/ already covers it.
.*/
!.github/
!.changeset/
!.vscode/
.vscode/*
!.vscode/extensions.json

node_modules/
dist/
dist-electron/
/release/
**/release/*.exe
**/release/*.AppImage
**/release/*.blockmap
**/release/*.yml
out/
coverage/
*.tsbuildinfo
dist-storylite/
storylite-static/
templates/app/build/
packages/create-brock/template/
packages/modules/*/android/build/

# AI config — managed in the private ai-config repo, never committed here
.ai-config.json
.claude/
CLAUDE.md
.claude/settings.json
.ai/
AGENTS.md
.codex/config.toml
.github/copilot-instructions.md

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": [
    "@drizztdourden08/tessera",
    "@electron-toolkit/utils",
    "@types/react-dom",
    "react",
    "react-dom",
    "zustand",
    "rimraf",
    "@drizztdourden08/standards"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".markdownlint-cli2.mjs",
        "*.config.{mjs,ts}"
      ],
      "project": [
        "*.{mjs,ts}"
      ]
    },
    "packages/lint-config": {
      "entry": [
        "*.mjs",
        "stylelint-rules/*.mjs"
      ],
      "project": [
        "**/*.mjs"
      ]
    },
    "packages/build": {
      "entry": [
        "standards.extension.mjs",
        "src/*.mjs",
        "migrations/*/*.mjs",
        "tests/**/*.test.ts",
        "tests/**/*.test.mjs"
      ],
      "project": [
        "**/*.mjs",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "playwright-core"
      ]
    },
    "packages/cli": {
      "project": [
        "**/*.mjs"
      ],
      "ignoreDependencies": [
        "@drizztdourden08/brock-thread"
      ]
    },
    "packages/create-brock": {
      "project": [
        "**/*.mjs"
      ]
    },
    "packages/core": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/electron": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "packages/react": {
      "entry": [
        "stories/**/*.stories.tsx",
        "stories/_samples/*.tsx",
        "src/compounds/*/*.usage.ts",
        "src/compounds/app-tree.*.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "stories/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ]
    },
    "packages/modules/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/modules/input": {
      "entry": [
        "src/compounds/*/*.usage.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "cmake-js",
        "node-addon-api"
      ]
    },
    "packages/modules/catalog": {
      "entry": [
        "src/compounds/*/*.usage.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ]
    },
    "packages/modules/display": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "koffi",
        "koffi-v2"
      ]
    },
    "packages/modules/port-kit": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.ts"
      ]
    },
    "templates/app": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "src/main.tsx",
        "src/ipc/contract.type.ts",
        "src/screens/**/*.custom.tsx",
        ".brock/*.ts",
        "*.config.{cjs,ts,mjs}",
        ".markdownlint-cli2.mjs",
        "brock.config.ts",
        "brock.workspace.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        ".brock/*.ts"
      ]
    }
  }
}

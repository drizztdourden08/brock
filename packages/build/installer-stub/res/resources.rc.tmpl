// @layer installer @kind config
#include <windows.h>

1 RT_MANIFEST "app.manifest"

1 ICON "app.ico"

// Kept as raw bytes instead of a bitmap so the alpha channel survives; the
// painter decodes it and scales it per screen.
101 RCDATA "logo-256.png"

// product.installer.licence as UTF-8 text; a single newline when there is none.
102 RCDATA "licence.txt"

// Keep in step with STUB_VERSION in packaging.constants.mjs: this is what Explorer's
// Details tab reports, and the stub shows the same number on screen.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "__PRODUCT__"
      VALUE "FileDescription", "__PRODUCT__ Setup"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "__STUB_FILE__"
      VALUE "OriginalFilename", "__STUB_FILE__.exe"
      VALUE "ProductName", "__PRODUCT__"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

{
  "name": "@drizztdourden08/brock-build",
  "version": "0.35.0",
  "description": "Brock build tooling: Vite and electron-builder config factories, ensure-electron, the platform strategies and workflow builder, and the brock CLI (sync, check, add, dev, build, start, adopt, structure, platform, doctor, web).",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "brock": "./bin/brock.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./config": {
      "types": "./src/config.d.mts",
      "default": "./src/config.mjs"
    },
    "./load-config": {
      "types": "./src/load-config.d.mts",
      "default": "./src/load-config.mjs"
    },
    "./vite": {
      "types": "./src/vite-config.d.mts",
      "default": "./src/vite-config.mjs"
    },
    "./vite-web": {
      "types": "./src/vite-web-config.d.mts",
      "default": "./src/vite-web-config.mjs"
    },
    "./builder": "./src/builder-config.mjs",
    "./testing": {
      "types": "./src/testing/index.d.mts",
      "default": "./src/testing/index.mjs"
    },
    "./theme": {
      "types": "./src/look/app-theme-css.d.mts",
      "default": "./src/look/app-theme-css.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "standards.extension.mjs",
    "src",
    "installer-stub",
    "migrations",
    "README.md",
    "CHANGELOG.md"
  ],
  "standards": {
    "extension": "./standards.extension.mjs"
  },
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-thread": "workspace:*",
    "@drizztdourden08/standards": "^0.8.0",
    "@resvg/resvg-js": "catalog:",
    "pngjs": "catalog:",
    "rcedit": "catalog:"
  },
  "devDependencies": {
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": ">=5",
    "electron": ">=38",
    "electron-builder": ">=26",
    "electron-vite": ">=5",
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "electron-builder": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  }
}

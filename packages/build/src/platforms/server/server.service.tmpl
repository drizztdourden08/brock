# @layer tooling-scripts @kind build
# Managed by brock sync: the systemd unit the .deb installs.
[Unit]
Description=__NAME__ server__PORTS__
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__ID__
Group=__ID__
StateDirectory=__ID__
StateDirectoryMode=0750
UMask=0027
ExecStart=/opt/__ID__/bin/__ID__-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes__CAPABILITIES__

[Install]
WantedBy=multi-user.target

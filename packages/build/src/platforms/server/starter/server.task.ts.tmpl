/* @layer electron-main @kind logic */
import { defineBootTask, embedServer } from '@drizztdourden08/brock-electron/main';
import { createDataDomains } from '@drizztdourden08/brock-electron/node';
import { dataDomains } from '../../server/data-domains';
import { start } from '../../server/start';

export default defineBootTask({
  label: 'Starting the server',
  after: ['modules'],
  run: async (ctx) => {
    await embedServer(start, ctx, { domains: (dataDir) => createDataDomains(dataDir, dataDomains) });
  },
});

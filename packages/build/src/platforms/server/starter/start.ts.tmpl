/* @layer electron-main @kind logic */
import type { DataDomains } from '@drizztdourden08/brock-electron/node';
import type { ServerStart } from '@drizztdourden08/brock-electron/server';

const start: ServerStart<DataDomains> = (host) => {
  host.log(`ready, ${host.domains?.list().length ?? 0} data domain(s) in ${host.dataDir}`);
  return { stop: () => host.log('stopping') };
};

export { start };

  quality:
    runs-on: ubuntu-latest
    steps:
__SETUP__

      - name: Build
        run: pnpm --dir "$APP_DIR" exec brock build

      - name: Release note
        run: pnpm --dir "$APP_DIR" exec brock release-notes check

      - name: App gate steps
        run: pnpm --dir "$APP_DIR" exec brock gate
__ROOT_STEPS__
  # The review job is pinned to one image, never ubuntu-latest: the apparmor step below and the
  # linux screenshot baselines both depend on the image, so a new Ubuntu moves only with Brock.
  review:
    runs-on: __REVIEW_RUNNER__
    steps:
__SETUP__

      - name: Build
        run: pnpm --dir "$APP_DIR" exec brock build

      - name: Let Electron start its sandbox
        run: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0

      - name: Install xvfb
        run: command -v xvfb-run || { sudo apt-get update && sudo apt-get install -y xvfb; }

      - name: Headless review
        run: __REVIEW_RUN____BASELINE_STEPS__

      - name: Keep the review report
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: review__ARTIFACT__
          path: __REVIEW_DATA__/Data/review/
          if-no-files-found: ignore

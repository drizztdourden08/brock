  # The review job is pinned to one image, never ubuntu-latest: the apparmor step below and the
  # linux screenshot baselines both depend on the image, so a new Ubuntu moves only with Brock.
  review:
    runs-on: __REVIEW_RUNNER__
    steps:
__REVIEW_SETUP____REVIEW_BEFORE_BUILD__

      - name: Build
        run: pnpm --dir "$APP_DIR" exec brock build__REVIEW_AFTER_BUILD__

__USERNS_STEP__

      - name: Install xvfb
        run: command -v xvfb-run || { sudo apt-get update && sudo apt-get install -y xvfb; }

      - name: Headless review
        run: __REVIEW_RUN____BASELINE_STEPS__

      - name: Keep the review report
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: review__ARTIFACT__
          path: __REVIEW_DATA__/Data/review/
          if-no-files-found: ignore

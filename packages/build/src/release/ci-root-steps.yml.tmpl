      - name: Managed files match brock sync
        run: pnpm exec brock check

      - name: Lint and typecheck (changed files)
        if: github.event_name == 'pull_request'
        run: pnpm run lint

      - name: Lint and typecheck (all files)
        if: github.event_name != 'pull_request'
        run: pnpm run lint:all

      - name: Markdown
        run: pnpm run --if-present lint:md

      - name: Structure
        run: pnpm exec brock structure --check

      - name: Tests (changed files)
        run: pnpm run --if-present test:pr

  __JOB__:
    needs: prepare
    runs-on: __RUNS_ON__
    steps:
__SETUP__
__VPK__
      - name: Package
        shell: bash
        env:
          CSC_IDENTITY_AUTO_DISCOVERY: 'false'
        run: |
          FULL=""
          if [ "${{ needs.prepare.outputs.full }}" = "true" ]; then FULL="--full"; fi
          pnpm --dir "$APP_DIR" exec brock package $FULL

      - name: Collect the release files
        shell: bash
        run: |
          mkdir -p upload
__COLLECT__
          ls -l upload

      - uses: actions/upload-artifact@v7
        with:
          name: release-__PLATFORM__
          path: upload/*

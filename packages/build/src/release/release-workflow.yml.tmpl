name: Release
run-name: Release ${{ inputs.version }}

# Managed by brock sync from the targets in brock.config.ts. Change the targets, then run brock sync.
# Run it from the Actions tab or with `<app> release <version>`.
# release-notes/v<version>.md must be on the default branch first: it is the release body.
on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Version to release, e.g. 0.9.0 or v0.9.0. The tag must not exist yet.'
        required: true
        type: string
      full:
        description: 'Rebuild the Windows installer payload and directory zip that the small installer fetches. The first release must be full.'
        type: boolean
        default: false
      prerelease:
        description: 'Publish as a pre-release. It never becomes the latest download.'
        type: boolean
        default: false
      set_latest:
        description: 'Publish at once as the latest release. Off leaves a draft.'
        type: boolean
        default: false

concurrency:
  group: release
  cancel-in-progress: false

permissions:
  contents: write
  packages: read

env:
  APP_DIR: __APP_DIR__

jobs:
  prepare:
    runs-on: ubuntu-latest
    outputs:
      tag: ${{ steps.resolve.outputs.tag }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check the notes and the tag
        id: resolve
        shell: bash
        run: |
          RAW="${{ inputs.version }}"
          TAG="v${RAW#v}"
          test -f "release-notes/$TAG.md" || { echo "::error::release-notes/$TAG.md is missing. Commit the notes first."; exit 1; }
          if git ls-remote --exit-code --tags origin "refs/tags/$TAG" >/dev/null 2>&1; then
            echo "::error::Tag $TAG already exists."
            exit 1
          fi
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

      - uses: pnpm/action-setup@v4
        with:
          version: 10
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: pnpm
          registry-url: https://npm.pkg.github.com
          scope: '@drizztdourden08'

      - name: Install
        run: pnpm install --frozen-lockfile
        env:
          NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Lint
        run: pnpm lint

      - name: Commit the version and tag it
        shell: bash
        run: |
          TAG="${{ steps.resolve.outputs.tag }}"
          node -e "const f=process.argv[1];const p=JSON.parse(require('fs').readFileSync(f,'utf8'));p.version=process.argv[2];require('fs').writeFileSync(f,JSON.stringify(p,null,2)+'\n')" "$APP_DIR/package.json" "${TAG#v}"
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add "$APP_DIR/package.json"
          if ! git diff --cached --quiet; then
            git commit -m "release: $TAG"
            git push origin "HEAD:${{ github.event.repository.default_branch }}"
          fi
          git tag "$TAG"
          git push origin "$TAG"

__JOBS__
  release:
    needs: __NEEDS__
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.prepare.outputs.tag }}

      - uses: actions/download-artifact@v4
        with:
          path: artifacts

      - name: Write the release body
        shell: bash
        run: |
          TAG="${{ needs.prepare.outputs.tag }}"
          BASE="https://github.com/${{ github.repository }}/releases/download/${TAG}"
          LATEST="https://github.com/${{ github.repository }}/releases/latest/download"
          link() { for f in $1; do if [ -f "$f" ]; then echo "- [$2]($BASE/$(basename "$f"))"; fi; done; }
          stub() { for f in $1; do if [ -f "$f" ]; then echo "- [$2]($LATEST/$(basename "$f"))"; fi; done; }
          {
            cat "release-notes/${TAG}.md"
            echo ""
            echo "## Downloads"
            echo ""
__DOWNLOADS__
          } > release-body.md
          cat release-body.md

      - uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ needs.prepare.outputs.tag }}
          draft: ${{ inputs.set_latest != true && inputs.prerelease != true }}
          prerelease: ${{ inputs.prerelease == true }}
          make_latest: ${{ inputs.set_latest == true }}
          body_path: release-body.md
          files: artifacts/release-*/*
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

name: CI __NAME__
run-name: CI __NAME__ ${{ github.head_ref || github.ref_name }}

# Managed by brock sync for the site in __APP_DIR__. A pull request checks and builds the site
# only when it touches the site's files, a workspace package it depends on, or a file outside
# every package. Brock deploys nothing: hosting the dist folder is the app's own workflow.
on:
  pull_request:
  workflow_dispatch:

concurrency:
  group: ci-__NAME__-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  packages: read

env:
  APP_DIR: __APP_DIR__

jobs:
__CHANGES__

  site:
    needs: changes
    if: needs.changes.outputs.changed == 'true'
    runs-on: ubuntu-latest
    steps:
__SETUP__

      - name: Typecheck and lint the site
        run: pnpm --dir "$APP_DIR" run lint

      - name: Build the site
        run: pnpm --dir "$APP_DIR" exec brock site build

      - uses: actions/upload-artifact@v4
        with:
          name: site-__NAME__
          path: ${{ env.APP_DIR }}/dist/
          if-no-files-found: error

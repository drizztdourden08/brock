/* @layer renderer-app @kind style */
.sign-in {
  flex: 1;
  padding: var(--space-xl);
  background: linear-gradient(135deg, var(--c-gradient-dark-from), var(--c-gradient-dark-to));
}

.sign-in__card {
  width: min(100%, 24rem);
  border-top: var(--border-width-thin) solid var(--c-gradient-light-to);
}

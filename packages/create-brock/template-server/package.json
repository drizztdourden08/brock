{
  "name": "brock-template-app",
  "version": "0.1.0",
  "private": true,
  "description": "A blank Brock server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "brock server dev",
    "build": "brock build",
    "package": "brock package",
    "start": "node dist/server/main.mjs",
    "sync": "brock sync",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && eslint . && brock prose && brock knip && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "deadcode": "brock knip",
    "duplicates": "jscpd ."
  },
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-electron": "workspace:*"
  },
  "devDependencies": {
    "@drizztdourden08/brock-build": "workspace:*",
    "@drizztdourden08/brock-lint-config": "workspace:*",
    "@drizztdourden08/brock-thread": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

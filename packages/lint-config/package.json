{
  "name": "@drizztdourden08/brock-lint-config",
  "version": "0.17.0",
  "description": "Brock's app preset on top of @drizztdourden08/standards: the same factories and exports as before, with the react-app preset and Brock's extension (Tessera names, screens, module entries, boot tasks, Tessera tokens).",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/lint-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./eslint.mjs",
    "./eslint": "./eslint.mjs",
    "./stylelint": "./stylelint.mjs",
    "./markdownlint": "./markdownlint.mjs",
    "./markdown-rules": "./markdown-rules.mjs",
    "./slop-patterns": "./slop-patterns.mjs",
    "./slop-line-kind": "./slop-line-kind.mjs",
    "./tsconfig/*": "./tsconfig/*",
    "./stylelint-rules/*": "./stylelint-rules/*",
    "./file-shape": "./file-shape.mjs",
    "./standards.extension.mjs": "./standards.extension.mjs"
  },
  "files": [
    "*.mjs",
    "tsconfig",
    "README.md",
    "stylelint-rules",
    "CHANGELOG.md"
  ],
  "standards": {
    "extension": "./standards.extension.mjs"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "markdownlint-cli2": "^0.22.0",
    "stylelint": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "markdownlint-cli2": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "dependencies": {
    "@drizztdourden08/standards": "^0.6.0"
  }
}

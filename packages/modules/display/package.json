{
  "name": "@drizztdourden08/brock-display",
  "version": "0.35.0",
  "description": "Brock display module: refresh rate detection, a synced rate borrowed for fullscreen, window mode and monitor switching, and a settings tab.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/modules/display"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "brock": {
    "id": "display",
    "description": "Refresh rate detection, a synced rate for fullscreen, and window mode and monitor switching.",
    "main": "./src/main/index.ts",
    "preload": "./src/preload/index.ts",
    "renderer": "./src/renderer/index.ts",
    "peers": [
      "koffi"
    ],
    "packExclude": [
      "android/**"
    ]
  },
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-electron": "workspace:*",
    "@drizztdourden08/brock-react": "workspace:*"
  },
  "devDependencies": {
    "@drizztdourden08/tessera": "catalog:",
    "electron": "catalog:",
    "koffi": "^3.1.2",
    "koffi-v2": "npm:koffi@^2.16.3",
    "react": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@drizztdourden08/tessera": "*",
    "electron": ">=38",
    "koffi": "^2.9.0 || ^3.0.0",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    }
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}

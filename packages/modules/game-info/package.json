{
  "name": "@drizztdourden08/brock-game-info",
  "version": "0.122.0",
  "description": "Brock game info module: one game info widget shared by every game. The game supplies a provider with a snapshot reader, a section list and its core and lock signals, and the module polls, diffs and draws it.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/modules/game-info"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "brock": {
    "id": "game-info",
    "description": "One game info widget shared by every game: the game supplies a provider, the module polls, diffs and draws it.",
    "renderer": "./src/renderer/index.ts"
  },
  "dependencies": {
    "@drizztdourden08/brock-react": "workspace:*"
  },
  "devDependencies": {
    "@drizztdourden08/tessera": "catalog:",
    "react": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@drizztdourden08/tessera": ">=0.87.0 <1",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  }
}

{
  "name": "@drizztdourden08/brock-input",
  "version": "0.1.2",
  "description": "Brock input module: SDL3 controllers with hotplug and live state, the gamecontrollerdb mapping database, stick and trigger calibration, rumble, and the InputTester screen.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/modules/input"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node bin/ensure-addon.mjs --postinstall",
    "addon:build": "node bin/ensure-addon.mjs --force",
    "addon:prepare": "node bin/ensure-addon.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./gamecontrollerdb.txt": "./resources/gamecontrollerdb.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "ensure-addon",
    "native/src",
    "native/CMakeLists.txt",
    "native/package.json",
    "src",
    "resources",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "brock": {
    "id": "input",
    "description": "SDL3 controllers, the mapping database, calibration, rumble and the InputTester screen.",
    "main": "./src/main/index.ts",
    "preload": "./src/preload/index.ts",
    "renderer": "./src/renderer/index.ts",
    "dataDirs": [
      "input"
    ],
    "prepare": "./bin/ensure-addon.mjs",
    "extraResources": [
      {
        "from": "./native/prebuilds/${platform}-${arch}",
        "to": "sdl3/${platform}-${arch}"
      },
      {
        "from": "./resources/gamecontrollerdb.txt",
        "to": "gamecontrollerdb.txt"
      }
    ],
    "packExclude": [
      "native/**"
    ],
    "ci": [
      {
        "name": "Install libusb and pkg-config (Linux)",
        "run": "sudo apt-get update && sudo apt-get install -y libusb-1.0-0-dev pkg-config",
        "os": "linux"
      },
      {
        "name": "Install libusb and pkg-config (macOS)",
        "run": "brew install libusb pkg-config",
        "os": "macos"
      }
    ],
    "doctor": [
      {
        "name": "libusb and pkg-config",
        "os": "linux",
        "probe": [
          "pkg-config",
          "--exists",
          "libusb-1.0"
        ],
        "install": "sudo apt-get install -y libusb-1.0-0-dev pkg-config"
      },
      {
        "name": "libusb and pkg-config",
        "os": "macos",
        "probe": [
          "pkg-config",
          "--exists",
          "libusb-1.0"
        ],
        "install": "brew install libusb pkg-config"
      }
    ],
    "udevRules": "./resources/controllers.rules"
  },
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-electron": "workspace:*",
    "@drizztdourden08/brock-react": "workspace:*"
  },
  "devDependencies": {
    "@drizztdourden08/tessera": "catalog:",
    "cmake-js": "catalog:",
    "electron": "catalog:",
    "node-addon-api": "catalog:",
    "react": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "@drizztdourden08/tessera": "*",
    "electron": ">=38",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  }
}

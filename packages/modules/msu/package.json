{
  "name": "@drizztdourden08/brock-msu",
  "version": "0.122.0",
  "description": "Brock MSU module: the shared MSU-1 and MSU-L music pack format, pack storage, the layered music player and the session that follows a running game. The game supplies its track loops, music classifier, sound channels and save paths.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/modules/msu"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./augment": "./src/augment.ts",
    "./format": "./src/entries/format/index.ts",
    "./main": "./src/main/index.ts",
    "./packs": "./src/entries/packs/index.ts",
    "./player": "./src/entries/player/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./session": "./src/entries/session/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/augment.ts"
  ],
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-electron": "workspace:*",
    "@drizztdourden08/brock-react": "workspace:*",
    "@drizztdourden08/brock-tools": "workspace:*",
    "jszip": "^3.10.1"
  },
  "brock": {
    "id": "msu",
    "description": "MSU packs: studio, music debugger, .msul open and the optimize handlers",
    "main": "./src/main/index.ts",
    "preload": "./src/preload/index.ts",
    "renderer": "./src/renderer/index.ts"
  },
  "devDependencies": {
    "@drizztdourden08/tessera": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@drizztdourden08/tessera": ">=0.87.0 <1",
    "electron": ">=38",
    "react": "^19.0.0"
  }
}

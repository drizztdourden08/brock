{
  "name": "@drizztdourden08/brock-secrets",
  "version": "0.33.0",
  "description": "Brock secrets module: named secrets kept as safeStorage ciphertext under Data/secrets, read in clear by main only; a generic device-code sign-in driver.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizztdourden08/brock.git",
    "directory": "packages/modules/secrets"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main/index.ts",
    "./preload": "./src/preload/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "brock": {
    "id": "secrets",
    "description": "Encrypted secret store on Electron safeStorage and a device-code sign-in driver.",
    "main": "./src/main/index.ts",
    "preload": "./src/preload/index.ts",
    "renderer": "./src/renderer/index.ts",
    "dataDirs": [
      "secrets"
    ]
  },
  "dependencies": {
    "@drizztdourden08/brock-core": "workspace:*",
    "@drizztdourden08/brock-electron": "workspace:*",
    "@drizztdourden08/brock-react": "workspace:*"
  },
  "devDependencies": {
    "electron": "catalog:",
    "react": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "electron": ">=38",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  }
}

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "src/main.tsx",
    ".brock/*.ts",
    "*.config.{cjs,ts,mjs}",
    ".markdownlint-cli2.mjs",
    "brock.config.ts",
    "brock.workspace.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts",
    ".brock/*.ts"
  ],
  "ignoreDependencies": [
    "@electron-toolkit/utils",
    "velopack",
    "zustand"
  ]
}

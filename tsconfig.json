{
  "extends": "./packages/lint-config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/tests/**/*",
    "packages/*/stories/**/*",
    "packages/modules/*/src/**/*",
    "packages/modules/*/tests/**/*",
    "templates/app/src/**/*",
    "templates/app/electron/**/*"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/out/**"]
}
